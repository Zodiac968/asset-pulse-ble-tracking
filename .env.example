# AssetPulse frontend configuration.
# These values are PUBLIC identifiers. Never put AWS access keys or secrets here.

# AWS region of the existing backend (do not change).
VITE_AWS_REGION=ap-southeast-2

# Cognito User Pool ID, e.g. ap-southeast-2_AbCdEfGhI
VITE_COGNITO_USER_POOL_ID=

# Cognito app client ID (public client, no secret, Authorization Code + PKCE).
VITE_COGNITO_CLIENT_ID=

# Cognito Managed Login domain, e.g. assetpulse.auth.ap-southeast-2.amazoncognito.com
# (with or without https://)
VITE_COGNITO_DOMAIN=

# Deployed API Gateway HTTP API base URL, e.g.
# https://abc123.execute-api.ap-southeast-2.amazonaws.com
VITE_API_BASE_URL=

# Optional overrides
# VITE_COGNITO_SCOPES=openid email profile asset-tracker/read asset-tracker/write
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
